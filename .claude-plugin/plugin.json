{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "gbif-biodiversity-mcp-server",
  "version": "0.7.6",
  "description": "Search GBIF species taxonomy, occurrence records, datasets, and publishers via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/gbif-biodiversity-mcp-server#readme",
  "repository": "https://github.com/cyanheads/gbif-biodiversity-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "gbif", "biodiversity", "species", "taxonomy"],
  "userConfig": {
    "gbif_clamp_read_limits": {
      "type": "boolean",
      "title": "Clamp read limits",
      "description": "Clamp oversized read requests to their documented caps and return unprocessed bulk names. Disable to reject oversized requests instead.",
      "required": false,
      "default": true
    }
  },
  "mcpServers": {
    "gbif-biodiversity-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/gbif-biodiversity-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "GBIF_CLAMP_READ_LIMITS": "${user_config.gbif_clamp_read_limits}"
      }
    }
  }
}
